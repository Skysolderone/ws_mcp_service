    pipeline {
        agent any

        environment {
            // Git仓库配置
            GIT_REPO = 'https://github.com/Skysolderone/ws_mcp_service.git'
            GIT_BRANCH = 'master'

            // Docker镜像配置
            DOCKER_REGISTRY = 'harbor.wws741.top'
            IMAGE_NAME = 'mcp-rpc/order'
            IMAGE_TAG = "${BUILD_NUMBER}"

            // 生产服务器配置
            PROD_SERVER = 'ec2-54-65-152-26.ap-northeast-1.compute.amazonaws.com'
            PROD_USER = 'ec2-user'

            // Harbor凭证（用户名和密码，在Jenkins中配置）
            HARBOR_USERNAME = 'admin'
            HARBOR_PASSWORD = 'gg123456'  // 建议用Jenkins凭证而非明文
        }

        stages {
            stage('检出代码') {
                steps {
                    echo "拉取最新代码: ${GIT_REPO} 分支: ${GIT_BRANCH}"
                    git branch: "${GIT_BRANCH}", url: "${GIT_REPO}"
                }
            }

            stage('构建Docker镜像') {
                steps {
                    script {
                        echo "构建Docker镜像: ${IMAGE_NAME}:${IMAGE_TAG}"
                        sh """
                            cd ${WORKSPACE}
                            pwd && ls -la go.mod go.sum 2>/dev/null || true
                            docker build -f services/order/Dockerfile -t ${DOCKER_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} .
                            docker tag ${DOCKER_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} ${DOCKER_REGISTRY}/${IMAGE_NAME}:latest
                        """
                    }
                }
            }

            stage('推送镜像') {
                steps {
                    script {
                        echo '登录Harbor并推送镜像...'
                        sh """
                            echo ${HARBOR_PASSWORD} | docker login ${DOCKER_REGISTRY} -u ${HARBOR_USERNAME} --password-stdin
                            docker push ${DOCKER_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}
                            docker push ${DOCKER_REGISTRY}/${IMAGE_NAME}:latest
                            docker logout ${DOCKER_REGISTRY}
                        """
                    }
                }
            }

            stage('部署到生产环境') {
                steps {
                    script {
                        echo "部署到生产服务器: ${PROD_SERVER}"

                        // 使用sshagent管理SSH凭据
                        sshagent(['prod-ec2-ssh-key']) {
                            sh """
                                # 传输 docker-compose.yaml 到服务器
                                scp -o StrictHostKeyChecking=no services/order/docker-compose.yaml ec2-user@ec2-54-65-152-26.ap-northeast-1.compute.amazonaws.com:~/

                                ssh -o StrictHostKeyChecking=no ${PROD_USER}@${PROD_SERVER} '
                                    # 登录Harbor
                                    echo ${HARBOR_PASSWORD} | docker login ${DOCKER_REGISTRY} -u ${HARBOR_USERNAME} --password-stdin

                                    # 拉取最新镜像
                                    docker pull ${DOCKER_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}

                                    # 更新 compose 文件中的镜像标签
                                    sed -i "s|image:.*|image: ${DOCKER_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}|" ~/docker-compose.yaml

                                    # 使用 docker-compose 部署
                                    cd ~
                                    docker-compose down || true
                                    docker-compose up -d

                                    # 清理旧镜像
                                    docker images | grep 'mcp-rpc/order' | awk 'NR>1 {print \$3}' | xargs -r docker rmi -f || true  

                                    # 退出登录
                                    docker logout ${DOCKER_REGISTRY}
                                '
                            """
                        }
                    }
                }
            }

            stage('健康检查') {
                steps {
                    script {
                        echo '等待服务启动...'
                        sleep 10

                        sshagent(['prod-ec2-ssh-key']) {
                            sh """
                                ssh -o StrictHostKeyChecking=no ${PROD_USER}@${PROD_SERVER} '
                                    # 检查容器状态
                                    docker ps | grep order || echo "容器未运行"

                                    # 检查容器日志（最近10行）
                                    docker logs --tail 10 order || echo "无法获取容器日志"
                                '
                            """
                        }
                        echo '✓ 部署完成'
                    }
                }
            }
        }
    
        post {
            success {
                echo '🎉 部署成功！'
                // 可以添加通知，如钉钉、企业微信等
            }
            failure {
                echo '❌ 部署失败！'
                // 可以添加告警通知
            }
            always {
                script {
                    // 清理本地Docker镜像
                    sh "docker rmi ${env.DOCKER_REGISTRY}/${env.IMAGE_NAME}:${env.IMAGE_TAG} || true"
                }
            }
        }
    }
